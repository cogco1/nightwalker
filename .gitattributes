# Text files are stored with LF; Windows launchers keep CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.webp binary
*.otf binary
*.ttf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.blend binary
*.zip binary
*.pdf binary
